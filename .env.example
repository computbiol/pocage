# Environment template index for pocage.
#
# Copy the template that matches the mode you want:
#
#   cp .env.local.example .env.local
#   cp .env.compose.example .env.compose
#   cp .env.production.example .env.production
#
# Mode guide:
# - .env.local: host-side development, frontend 5173, backend 8000
# - .env.compose: Docker Compose, browser entrypoint 8080
# - .env.production: deployment placeholders for real domains and secrets
#
# Runtime selection:
# - host-side backend commands default to .env.local
# - docker compose reads .env.compose via docker-compose.yml
# - set POCAGE_ENV_FILE=.env.production to force a different backend env file
