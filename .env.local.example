#
# Example values only. Do not store real secrets in any *.example file.
#
ENVIRONMENT=development
PUBLIC_BASE_URL=http://127.0.0.1:8000
FRONTEND_URL=http://127.0.0.1:5173
DATABASE_URL=postgresql+asyncpg://postgres:postgres@127.0.0.1:5432/pocage
SECRET_KEY=change-me
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=30
COOKIE_SECURE=false
COOKIE_SAMESITE=lax
ACCESS_COOKIE_NAME=access_token
REFRESH_COOKIE_NAME=refresh_token
CSRF_COOKIE_NAME=csrf_token
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=no-reply@example.com
SMTP_FROM_NAME=pocage
SMTP_USE_STARTTLS=true
SMTP_USE_SSL=false
SMTP_TIMEOUT_SECONDS=10
POCAGE_CORS_ORIGINS=http://127.0.0.1:5173,http://localhost:5173
POCAGE_HOST=127.0.0.1
POCAGE_PORT=8000
POCAGE_FRONTEND_HOST=127.0.0.1
POCAGE_FRONTEND_PORT=5173
POCAGE_API_URL=http://127.0.0.1:8000
VITE_API_URL=http://127.0.0.1:8000
