#
# Example values only. Do not store real secrets in any *.example file.
#
ENVIRONMENT=production
POSTGRES_DB=pocage
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
PUBLIC_BASE_URL=https://pocage.example.com
FRONTEND_URL=https://pocage.example.com
DATABASE_URL=postgresql+asyncpg://postgres:postgres@db:5432/pocage
SECRET_KEY=replace-with-a-long-random-secret
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=30
COOKIE_SECURE=true
COOKIE_SAMESITE=lax
ACCESS_COOKIE_NAME=access_token
REFRESH_COOKIE_NAME=refresh_token
CSRF_COOKIE_NAME=csrf_token
SMTP_HOST=smtp.example.com
SMTP_PORT=465
SMTP_USERNAME=mailer@example.com
SMTP_PASSWORD=replace-me
SMTP_FROM_EMAIL=no-reply@pocage.example.com
SMTP_FROM_NAME=pocage
SMTP_USE_STARTTLS=false
SMTP_USE_SSL=true
SMTP_TIMEOUT_SECONDS=10
POCAGE_CORS_ORIGINS=https://pocage.example.com
POCAGE_HOST=0.0.0.0
POCAGE_PORT=8000
VITE_API_URL=
